<?xml version="1.0"?>
<sdf version="1.9">
  <model name="inis_pad">
    <static>true</static>
    <link name="base">
      <visual name="pad_visual">
        <pose>0 0 0.001 0 0 0</pose>
        <geometry>
          <plane><normal>0 0 1</normal><size>0.6 0.6</size></plane>
        </geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
          <pbr><metal>
            <albedo_map>model://inis_pad/materials/textures/pad.png</albedo_map>
            <metalness>0.0</metalness>
            <roughness>1.0</roughness>
          </metal></pbr>
        </material>
      </visual>
    </link>
  </model>
</sdf>
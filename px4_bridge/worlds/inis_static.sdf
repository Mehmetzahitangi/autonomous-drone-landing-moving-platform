<?xml version="1.0"?>
<sdf version="1.9">
  <world name="inis_static">
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
    </scene>
    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <cast_shadows>false</cast_shadows>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>0.1 0.3 -0.9</direction>
    </light>
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material><diffuse>0.6 0.6 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>
    <include><uri>model://inis_pad</uri><name>pad</name><pose>0 0 0 0 0 0</pose></include>
    <!-- Sabit kameralar: x y z roll pitch yaw (pitch 1.5708 = asagi bakar). validate_static.py'deki CAMS ile AYNI olmali -->
    <include><uri>model://inis_cam</uri><name>cam_a</name><pose>0 0 0.2 0 1.5708 0</pose></include>
    <include><uri>model://inis_cam</uri><name>cam_b</name><pose>0.10 -0.05 0.5 0 1.5708 0</pose></include>
    <include><uri>model://inis_cam</uri><name>cam_c</name><pose>0.20 0.15 1.0 0 1.5708 0.5</pose></include>
  </world>
</sdf>